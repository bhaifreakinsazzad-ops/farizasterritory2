{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/ghl-bundle",
      "dest": "/ghl-bundle.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
